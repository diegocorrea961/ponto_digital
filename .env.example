# Copie para .env e preencha. NUNCA coloque o .env no GitHub.

# Banco PostgreSQL. Local (docker compose up -d):
DATABASE_URL="postgres://ponto:ponto@localhost:5432/ponto"
# No Neon, use a URL DIRETA (sem -pooler) aqui no .env para rodar db:migrate e db:seed.
# Na Vercel, use a URL com pooling (-pooler).

# Assina o cookie de login. Mínimo 32 caracteres. Gere uma nova com:  openssl rand -base64 48
SESSION_SECRET="troque-por-um-texto-aleatorio-com-32-ou-mais-caracteres"

# Nome da loja (aparece no topo e nos relatórios).
STORE_NAME="Minha Loja"

# Usados só pelo "npm run db:seed" para criar a administradora.
# A senha precisa ter 10+ caracteres e não pode ser óbvia (ex.: 1234567890).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_NAME="Administradora"
